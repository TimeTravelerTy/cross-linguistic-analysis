# Copy to backend/.env and adjust as needed. All values are optional.

# Path to the CLICS network (defaults to data/clics/network-3-families.gml)
# CLICS_NETWORK_PATH=data/clics/network-3-families.gml

# Extra origins allowed to call the API (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only needed for the legacy /compare-concepts endpoint (LLM translations):
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama
# TRANSLATION_API_KEY=ollama
# TRANSLATION_MODEL=translategemma:4b
